# Bu dosyayı .env adıyla kopyalayın ve anahtarları doldurun.
# .env asla commit edilmez (.gitignore'da). Anahtarı sohbet gruplarına yapıştırmayın.
# Değişken adlarına VITE_ ön eki KOYMAYIN: VITE_ olanlar tarayıcıya gider.

# gemini (yayında kullanılan) | claude (isteğe bağlı)
ASTRA_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ana model yoğunsa (503), kota dolduysa (429) ya da bir isteğe 12 sn içinde cevap vermezse sırayla denenir.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash
# Bir isteğin bekleme süresi (ms). Canlı ölçüm ~6,7 sn; varsayılan 12000. Bunun altına indirmeyin.
GEMINI_MODEL_TIMEOUT_MS=12000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
