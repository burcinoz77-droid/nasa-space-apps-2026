# Copy this file to .env and fill in the keys.
# .env is never committed (it is in .gitignore). Do not paste keys into chat groups.
# Do NOT put the VITE_ prefix on variable names: anything with VITE_ is sent to the browser.

# gemini (used in production) | claude (optional)
ASTRA_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded (503), out of quota (429) or does not answer a request in time.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash
# Timeout for one request (ms). A simple question took ~11 s on the live site; default 24000. Do not go lower.
GEMINI_MODEL_TIMEOUT_MS=24000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
